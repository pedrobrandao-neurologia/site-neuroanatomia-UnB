a span {display:none} /*esconde caixa tooltip*/

/*mostra e estiliza a caixa tooltip*/
a.ponto1:hover span, a.ponto2:hover span,  
a.ponto3:hover span, a.ponto4:hover span,  
a.ponto5:hover span,  a.ponto6:hover span,
a.ponto7:hover span, a.ponto8:hover span,
a.ponto9:hover span, a.ponto10:hover span,
a.ponto11:hover span, a.ponto12:hover span,
a.ponto13:hover span, a.ponto14:hover span,
a.ponto15:hover span { 
width:160px; 
display:block;
position:absolute;
font:11px arial, verdana, helvetica, sans-serif; 
text-align:center;
padding:5px; 
border:1px solid #06c;
background:#fff; 
color:#000;
text-decoration:none;
}
/*box model para browsers conformes*/
li>a.ponto1:hover span, li>a.ponto2:hover span,  
li>a.ponto3:hover span, li>a.ponto4:hover span,  
li>a.ponto5:hover span,  li>a.ponto6:hover span,
li>a.ponto7:hover span, li>a.ponto8:hover span,
li>a.ponto9:hover span, li>a.ponto10:hover span,
li>a.ponto11:hover span, li>a.ponto12:hover span,
li>a.ponto13:hover span, li>a.ponto14:hover span,
li>a.ponto15:hover span { 
width:148px;
}
/*posiciona as caixas tooltip*/
a.ponto1:hover  { 
border:none;
top:5px;
left:5px;
}
