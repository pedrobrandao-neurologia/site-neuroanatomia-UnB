<style type="text/css">
ul { /*a área do menu*/
position:relative; /*contexto de posicionamento*/
/*retira bullets da lista*/
padding:0; 
margin:0;  
  
/*dimensões da área do menu*/
width:493px; 
height:625px;
  
/*Posicionando a imagem*/
background: url('imagens/medu5.jpg') no-repeat 0px 0px;; list-style-type:none 
}
/*As regras para a (âncora) criam o efeito visual
para os bullets sobre o crânio, 
são os pontos clicáveis*/
a {
position:absolute;
display:block;
text-decoration:none;
text-align:center;
color:red;
border:3px solid red;/*simula o 
quadradinho */
}
/*As regras a seguir posicionam os 
bullets sobre o crânio*/
a.ponto1{
top:240px;
left:230px;
}
a.ponto2{
top:8px;
left:221px;
}
a.ponto3{
top:258px;
left:173px;
}
a.ponto4{
