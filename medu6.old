font:11px arial, verdana, helvetica, sans-serif; 
text-align:center;
padding:5px; 
border:1px solid #06c;
background:#fff; 
color:#000;
text-decoration:none;
}
/*box model para browsers conformes*/
li>a.ponto1:hover span, li>a.ponto2:hover span,  
li>a.ponto3:hover span, li>a.ponto4:hover span,  
li>a.ponto5:hover span,  li>a.ponto6:hover span,
li>a.ponto7:hover span, li>a.ponto8:hover span,
li>a.ponto9:hover span, li>a.ponto10:hover span,
li>a.ponto11:hover span, li>a.ponto12:hover span,
li>a.ponto13:hover span { 
width:148px;
}
